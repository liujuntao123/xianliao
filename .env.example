# ====== 闲记环境变量 ======

# 访问口令（必填）：前端首次进入时输入，后端校验。请使用足够长的随机串，例如：
#   openssl rand -hex 32
ACCESS_KEY=

# 以下三项由「首启向导」扫码后自动生成并展示，填回这里（或对应平台的
# 环境变量设置处）后重启/重新部署即可。也可走「手动路径」自行创建。
# 飞书应用凭证（二选一必填：APP_ID/APP_SECRET 或走向导）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 多维表格 app_token（可留空：若 Base 是应用自动创建的，后端会按名称自动发现）
FEISHU_BASE_TOKEN=

# 飞书域名：feishu（国内版，默认）或 lark（国际版）
FEISHU_DOMAIN=feishu

# Node 适配器监听端口（Docker/自托管用，默认 3000）
PORT=3000
